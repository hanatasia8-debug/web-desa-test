// ==========================================
// Prisma Schema for VillageCMS — Desa Pringgodani
// Database: PostgreSQL (Docker lokal untuk development,
// dipindah ke Supabase Postgres saat production)
//
// Disalin apa adanya dari prd_2.txt §6.2, ditambah model Banner dan
// Settings (disebut di brief awal, belum ada di skema PRD) — didesain
// mengikuti pola & konvensi penamaan entitas lain di skema ini, sesuai
// field yang disebutkan di 01-architecture-plan.md §5:
//   Banner (id, imageUrl, title, linkUrl, order, isActive)
//   Settings (id, key, value)
//
// NOTE (adaptasi tooling, BUKAN perubahan struktur model/relasi):
// `generator client { output }` ditambahkan secara eksplisit karena
// Prisma 7 mewajibkan output path kustom (breaking change dari default
// Prisma <7). Semua model, enum, field, relasi, index, dan @map/@@map
// TIDAK diubah dari PRD.
// ==========================================

// NOTE (adaptasi tooling, BUKAN perubahan struktur): `url`/`directUrl` tidak
// lagi diizinkan di sini oleh Prisma 7 — keduanya pindah ke `prisma.config.ts`
// (untuk CLI/Migrate) dan ke driver adapter di `src/shared/lib/prisma.ts`
// (untuk runtime client).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// ------------------------------------------
// Enums
// ------------------------------------------

enum UserRole {
  SUPER_ADMIN
  VILLAGE_ADMIN
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  REVISION_REQUESTED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum UmkmCategory {
  KULINER
  FASHION
  PERTANIAN_PETERNAKAN
  KERAJINAN_SOUVENIR
  JASA
  PERDAGANGAN
}

enum PotentialCategory {
  PERTANIAN
  PERKEBUNAN
  PETERNAKAN
  PERIKANAN
  PARIWISATA
  KEBUDAYAAN
  KERAJINAN
  SUMBER_DAYA_ALAM
}

enum FacilityCategory {
  KANTOR_DESA
  SEKOLAH
  TEMPAT_IBADAH
  FASILITAS_KESEHATAN
  DESTINASI_WISATA
  FASILITAS_UMUM
}

enum ActionType {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_REVISION
  UPDATE
  DELETE
}

// ------------------------------------------
// Models
// ------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(VILLAGE_ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  newsCreated News[]            @relation("NewsAuthor")
  auditLogs   AuditLog[]
  revisions   RevisionHistory[]

  @@map("users")
}

model NewsCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  news News[]

  @@map("news_categories")
}

model News {
  id              String        @id @default(uuid()) @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  authorId        String?       @map("author_id") @db.Uuid
  title           String
  slug            String        @unique
  summary         String
  coverImage      String        @map("cover_image")
  coverCaption    String        @map("cover_caption")
  contentSections Json          @map("content_sections") // Array of { section_title, paragraph, section_image }
  status          ContentStatus @default(PENDING_REVIEW)

  // Community Submission Fields
  submitterName  String? @map("submitter_name")
  submitterEmail String? @map("submitter_email")
  submitterPhone String? @map("submitter_phone")
  revisionToken  String? @unique @map("revision_token")
  adminFeedback  String? @map("admin_feedback") @db.Text

  publishedAt DateTime? @map("published_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category NewsCategory @relation(fields: [categoryId], references: [id])
  author   User?        @relation("NewsAuthor", fields: [authorId], references: [id])

  @@index([status, publishedAt])
  @@index([slug])
  @@map("news")
}

model Umkm {
  id             String        @id @default(uuid()) @db.Uuid
  potentialId    String?       @map("potential_id") @db.Uuid
  name           String
  slug           String        @unique
  ownerName      String        @map("owner_name")
  category       UmkmCategory
  description    String        @db.Text
  whatsappNumber String        @map("whatsapp_number")
  address        String        @db.Text
  latitude       Float
  longitude      Float
  logo           String
  gallery        Json // Array of image URLs
  status         ContentStatus @default(PENDING_REVIEW)

  // Community Submission Fields
  submitterEmail String? @map("submitter_email")
  revisionToken  String? @unique @map("revision_token")
  adminFeedback  String? @map("admin_feedback") @db.Text

  publishedAt DateTime? @map("published_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  potential VillagePotential? @relation(fields: [potentialId], references: [id])
  products  UmkmProduct[]

  @@index([status, publishedAt])
  @@index([category])
  @@index([slug])
  @@map("umkm")
}

model UmkmProduct {
  id           String  @id @default(uuid()) @db.Uuid
  umkmId       String  @map("umkm_id") @db.Uuid
  productName  String  @map("product_name")
  price        Int?
  productPhoto String? @map("product_photo")

  umkm Umkm @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@map("umkm_products")
}

model VillagePotential {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  slug        String            @unique
  category    PotentialCategory
  overview    String
  description String            @db.Text
  coverImage  String            @map("cover_image")
  gallery     Json // Array of image URLs
  latitude    Float
  longitude   Float
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  umkms Umkm[]

  @@index([slug])
  @@map("village_potentials")
}

model PublicFacility {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  category       FacilityCategory
  address        String           @db.Text
  latitude       Float
  longitude      Float
  image          String?
  operatingHours String?          @map("operating_hours")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@map("public_facilities")
}

model VillageProfile {
  id           String   @id @default(uuid()) @db.Uuid
  villageName  String   @map("village_name")
  headGreeting String   @map("head_greeting") @db.Text
  headPhoto    String   @map("head_photo")
  historyText  String   @map("history_text") @db.Text
  vision       String   @db.Text
  missions     Json // Array of strings
  officials    Json // Array of { name, position, photo }
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("village_profile")
}

model RevisionHistory {
  id         String     @id @default(uuid()) @db.Uuid
  entityType String     @map("entity_type") // "NEWS" or "UMKM"
  entityId   String     @map("entity_id") @db.Uuid
  action     ActionType
  notes      String?    @db.Text
  adminId    String?    @map("admin_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")

  admin User? @relation(fields: [adminId], references: [id])

  @@map("revision_histories")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  payload    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ------------------------------------------
// Tambahan sesuai brief awal (belum ada di PRD §6.2):
// Banner (id, imageUrl, title, linkUrl, order, isActive)
// Settings (id, key, value)
// Mengikuti konvensi penamaan & tipe yang sama dengan model di atas.
// ------------------------------------------

model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, order])
  @@map("banners")
}

model Settings {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
