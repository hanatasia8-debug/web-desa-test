# Prisma — PostgreSQL lokal (Docker) untuk development.
# Saat go-live, tinggal diganti ke connection string Supabase Postgres
# (schema tidak berubah).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pringgodani?schema=public"
# Untuk Docker lokal, DIRECT_URL sama dengan DATABASE_URL (tidak ada pooler).
# Saat pindah ke Supabase/Neon, isi dengan direct (non-pooled) connection string.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pringgodani?schema=public"

# Opsional. Service Layer memanggil Route Handler app ini sendiri lewat HTTP;
# di server, origin-nya dideteksi otomatis dari header Host tiap request.
# Isi ini HANYA kalau server perlu memanggil dirinya lewat alamat internal lain
# (mis. di belakang proxy/container). Contoh: "http://localhost:3000/api"
# INTERNAL_API_BASE_URL=""

# Supabase Auth + Storage — buat project di https://supabase.com, lalu isi
# dari Project Settings > API. Tanpa ini: halaman publik & dev server tetap
# jalan normal (validasi lazy), tapi /admin/* dan upload gambar akan error
# saat diakses/dipakai (helper upload otomatis fallback ke local disk
# `public/uploads/` jika SUPABASE_SERVICE_ROLE_KEY kosong).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
