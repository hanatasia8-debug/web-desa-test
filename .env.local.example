# ============================================================
# Frontend Environment Variables — Desa Pringgodani
# ============================================================

# URL backend API (Next.js serverless web-desa)
# Local Dev: http://localhost:3000/api
# Vercel Production Example: https://your-backend.vercel.app/api
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Internal SSR API URL (For Vercel Server-Side Rendering)
# Pada Vercel, isi sama dengan NEXT_PUBLIC_API_URL
INTERNAL_API_URL="http://localhost:3000/api"

# Google Maps API Key (Ganti dengan API Key milik Anda)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"

# Optional: Custom allowed origins for local dev (comma-separated)
# ALLOWED_DEV_ORIGINS="192.168.1.50,custom-domain.local"